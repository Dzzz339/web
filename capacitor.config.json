{
  "appId": "ru.stockeasy.app",
  "appName": "Stockeasy",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "app.stockeasy.ru",
      "*.stockeasy.ru"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#18181B",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#18181B"
    }
  }
}
