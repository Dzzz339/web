# ==============================================================================
# StockEasy — Пример конфигурации окружения (.env.example)
# ==============================================================================

PORT=3005
NODE_ENV=production
DATABASE_URL=postgres://user:password@localhost:5432/stockeasy_db
JWT_SECRET=

# Начальный администратор создаётся только в пустой БД при задании обоих значений
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Администратор

# DaData (автодополнение адресов)
DADATA_API_KEY=
DADATA_SECRET_KEY=

# ИИ-ассистент Стоки: официальный облачный API DeepSeek
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=deepseek-chat

# Seafile (опциональное файловое хранилище)
SEAFILE_URL=
SEAFILE_API_TOKEN=
SEAFILE_REPO_ID=

CORS_ORIGIN=