# ==============================================================================
# StockEasy — Конфигурация окружения (.env.example)
# Скопируйте этот файл в .env и настройте параметры для развертывания
# ==============================================================================

# Порт HTTP-сервера (по умолчанию 3001)
PORT=3001

# Режим работы: development | production
NODE_ENV=production

# Подключение к базе данных PostgreSQL
# Формат: postgres://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stockeasy_db

# Секретный ключ для подписи JWT-токенов пользователей (минимум 64 символа)
# Генерация ключа: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_minimum_64_chars

# Интеграция с DaData (автозаполнение реквизитов контрагентов по ИНН и геокодирование)
DADATA_API_KEY=
DADATA_SECRET_KEY=

# ИИ-ассистент и парсер спецификаций (OpenAI / локальный LLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Настройки CORS (разрешенные домены через запятую, либо * для всех)
CORS_ORIGIN=*
